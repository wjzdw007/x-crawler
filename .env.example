# X平台认证配置
X_AUTH_TOKEN=your_auth_token_here
X_CT0_TOKEN=your_ct0_token_here
X_CSRF_TOKEN=your_csrf_token_here
X_BEARER_TOKEN=Bearer_YOUR_BEARER_TOKEN_HERE

# LLM配置 — 腾讯云 DeepSeek（OpenAI 兼容接口）
# 文档: https://cloud.tencent.com/document/product/1772/115969
# 密钥从腾讯云「知识引擎原子能力 / TokenHub」API Key 页面创建，勿提交真实值
TENCENT_DEEPSEEK_API_KEY=your_tencent_deepseek_api_key_here
# 可选别名（与官方文档 LKEAP_API_KEY 一致）
# LKEAP_API_KEY=

# 默认走 LKEAP DeepSeek；若已迁移 TokenHub 可覆盖为：
#   https://tokenhub.tencentmaas.com/v1
OPENAI_BASE_URL=https://api.lkeap.cloud.tencent.com/v1
# LKEAP 文档中的聊天模型：deepseek-v3.2 / deepseek-v3.1-terminus / deepseek-v3-0324 / deepseek-r1-0528
OPENAI_MODEL=deepseek-v3.2

# 代理配置（可选）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# 爬虫配置
REQUESTS_PER_HOUR=400
RETRY_ATTEMPTS=3
RETRY_DELAY=5
TIMEOUT=30
DAILY_TWEET_COUNT=100

# 数据目录配置
DATA_DIR=crawler_data

# 仅本地调试：允许写入模拟总结（生产 / CI 禁止）
# ALLOW_MOCK_SUMMARY=1
